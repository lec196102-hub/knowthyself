# Triune Journal 环境配置
# 推荐: 运行 npx tsx src/llm-setup.ts 交互式配置
# 或手动编辑下方参数

# === LLM 提供商 (推荐: 硅基流动 免费) ===
LLM_PROVIDER=siliconflow
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# === 审计模式：主审分离 (可选，节省成本) ===
# 留空则三个Agent共用上方LLM_MODEL
# LLM_AUDIT_MAIN_MODEL=Pro/Qwen/Qwen2.5-7B-Instruct
# LLM_AUDIT_REVIEW_MODEL=Qwen/Qwen2.5-7B-Instruct

# === 服务端口 ===
PORT=3000

# === 安全过滤 (可选) ===
SAFETY_API_KEY=
SAFETY_BASE_URL=https://api.openai.com/v1

# === 存储 ===
JOURNAL_DIR=./data/journals

# === 日志 ===
LOG_LEVEL=info
